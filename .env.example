# Copy to .env (git-ignored). Never put a key or secret in a VITE_ variable.

# mock = built-in sample data, live = the FastAPI backend
VITE_API_MODE=mock
# Empty uses the same origin (the Vite dev proxy forwards /api). Set for a hosted backend.
VITE_API_BASE_URL=
# Comma-separated company email domains. Empty means sign-in is refused ("not configured").
VITE_ALLOWED_EMAIL_DOMAINS=
VITE_MAX_UPLOAD_MB=25
# Optional sponsor logo (a path under public/ or a URL)
VITE_SPONSOR_LOGO=
